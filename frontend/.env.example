# Frontend example env
# Use Vite variable prefix VITE_

# REQUIRED: API URL for backend communication
# Note: This variable is embedded at BUILD TIME by Vite
# Changes to this file require rebuilding the frontend: npm run build
# Development (local):
VITE_API_URL=http://localhost:8000

# Production example:
# VITE_API_URL=https://api.seu-dominio.com
