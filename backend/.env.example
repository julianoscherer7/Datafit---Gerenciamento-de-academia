# Backend example env (no secrets)

# URLs do frontend autorizadas para CORS (separadas por vírgula)
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://seu-dominio.com

# Host/port
HOST=0.0.0.0
PORT=8000

# Banco de dados
# DB_ENGINE: 'auto' | 'sqlite' | 'mysql'
# - 'auto' (padrão) usa DATABASE_URL se presente, senão cria um sqlite local
# Exemplos:
#  - MySQL (use DATABASE_URL ou as variáveis abaixo):
#    DB_ENGINE=mysql
#    DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/fitdata_dev
#    MYSQL_USER=root
#    MYSQL_PASSWORD=senha
#    MYSQL_HOST=localhost
#    MYSQL_PORT=3306
#    MYSQL_DB=fitdata_dev
#  - SQLite (arquivo local):
#    DB_ENGINE=sqlite
#    SQLITE_URL=sqlite:///./fitdata_dev.db
