# ============================================
# FITDATA - Configurações de Ambiente
# ============================================

# ============================================
# 🗄️ BANCO DE DADOS (MySQL)
# ============================================
# Formato: mysql+pymysql://usuario:senha@host:porta/banco_dados
# Exemplos:
#   - Local: mysql+pymysql://root:senha@localhost:3306/fitdata_dev
#   - Docker: mysql+pymysql://root:senha@mysql-container:3306/fitdata_dev
#   - Remoto: mysql+pymysql://usuario:senha@seu-servidor.com:3306/fitdata_dev

DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/fitdata_dev

# Configurações de conexão
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ============================================
# 🔐 SEGURANÇA - JWT (JSON Web Token)
# ============================================
# Gere uma chave secreta forte para produção
# Exemplo de geração: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NÃO use a chave padrão em produção!

SECRET_KEY=your-super-secret-key-change-in-production-fitdata-2024-12345678901234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# 🚀 CONFIGURAÇÃO DO SERVIDOR
# ============================================
DEBUG=true
ENVIRONMENT=development

# Para produção, mude para:
# ENVIRONMENT=production
# DEBUG=false

# Host e porta
HOST=0.0.0.0
PORT=8000

# ============================================
# 📧 EMAIL (Opcional - para notificações)
# ============================================
# EMAIL_PROVIDER=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu-email@gmail.com
# EMAIL_PASSWORD=sua-senha-app
# EMAIL_FROM=noreply@fitdata.com

# ============================================
# 📊 LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/fitdata.log

# ============================================
# 🔗 CORS (Frontend)
# ============================================
# URLs do frontend autorizadas para requisições CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://seu-dominio.com

# ============================================
# 💾 UPLOAD DE ARQUIVOS
# ============================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_FOLDER=uploads/

# ============================================
# 📱 PAGINAÇÃO
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
